#!/usr/bin/env python3
"""Fake Claude Code CLI for tests: echoes a canned structured_output (or an error) as `claude -p --output-format json` does."""
import json, os, sys
args = sys.argv[1:]
prompt = sys.stdin.read()
mode = os.environ.get("FAKE_CLAUDE_MODE", "ok")
if mode == "limit":
    print(json.dumps({"type": "result", "subtype": "error", "is_error": True, "result": "Claude usage limit reached. Your limit resets at 5pm."}))
    sys.exit(1)
schema = json.loads(args[args.index("--json-schema") + 1]) if "--json-schema" in args else {}
canned = json.loads(open(os.environ["FAKE_CLAUDE_REPLY"]).read()) if os.environ.get("FAKE_CLAUDE_REPLY") else {"ok": True}
log = os.environ.get("FAKE_CLAUDE_LOG")
if log:
    open(log, "a").write(json.dumps({"args": args, "cwd": os.getcwd(), "prompt_len": len(prompt), "has_bare": "--bare" in args}) + "\n")
print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": json.dumps(canned), "structured_output": canned,
                  "total_cost_usd": 0.01, "usage": {"input_tokens": len(prompt) // 4, "output_tokens": 50}}))
