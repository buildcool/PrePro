#!/usr/bin/env python3
"""Fake Claude Code CLI for tests: echoes a canned structured_output (or an error) as `claude -p --output-format json` does.
Reads stdin and the system-prompt file as UTF-8 (like the real CLI) and logs what arrived, so tests can check that
non-ASCII text (₹, “quotes”, Hindi) survives the trip on every OS."""
import json, os, sys
args = sys.argv[1:]
prompt = sys.stdin.buffer.read().decode("utf-8")
mode = os.environ.get("FAKE_CLAUDE_MODE", "ok")
if mode == "limit":
    print(json.dumps({"type": "result", "subtype": "error", "is_error": True, "result": "Claude usage limit reached. Your limit resets at 5pm."}))
    sys.exit(1)
schema = json.loads(args[args.index("--json-schema") + 1]) if "--json-schema" in args else {}
system = ""
if "--system-prompt-file" in args:
    with open(args[args.index("--system-prompt-file") + 1], encoding="utf-8") as f:
        system = f.read()
elif "--system-prompt" in args:
    system = args[args.index("--system-prompt") + 1]
canned = {"ok": True}
if os.environ.get("FAKE_CLAUDE_REPLY"):
    with open(os.environ["FAKE_CLAUDE_REPLY"], encoding="utf-8") as f:
        canned = json.load(f)
log = os.environ.get("FAKE_CLAUDE_LOG")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps({"args": args, "cwd": os.getcwd(), "prompt": prompt, "system": system, "schema": schema,
                            "has_bare": "--bare" in args}, ensure_ascii=False) + "\n")
out = {"type": "result", "subtype": "success", "is_error": False, "result": json.dumps(canned, ensure_ascii=False),
       "structured_output": canned, "total_cost_usd": 0.01, "usage": {"input_tokens": len(prompt) // 4, "output_tokens": 50}}
sys.stdout.buffer.write((json.dumps(out, ensure_ascii=False) + "\n").encode("utf-8"))
