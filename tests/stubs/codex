#!/usr/bin/env python3
"""Fake Codex CLI: writes the canned reply to the -o file like `codex exec --output-schema … -o file`."""
import json, os, sys
args = sys.argv[1:]
sys.stdin.read()
out = args[args.index("-o") + 1]
canned = json.loads(open(os.environ["FAKE_CODEX_REPLY"]).read()) if os.environ.get("FAKE_CODEX_REPLY") else {"ok": True}
open(out, "w").write(json.dumps(canned))
