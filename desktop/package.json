{
  "name": "prepro-desktop",
  "productName": "PrePro",
  "version": "0.11.0",
  "description": "PrePro — the AI pre-edit engine for creators (desktop app)",
  "main": "main.js",
  "author": {
    "name": "buildcool",
    "email": "buildcool@users.noreply.github.com"
  },
  "homepage": "https://github.com/buildcool/PrePro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.buildcool.prepro",
    "productName": "PrePro",
    "artifactName": "PrePro-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "splash.html",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "buildcool",
        "repo": "PrePro",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../dist/prepro-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "synopsis": "Turns a shoot folder into a reasoned first cut",
      "icon": "build/icon.png",
      "executableName": "prepro-desktop"
    },
    "deb": {
      "depends": [
        "ffmpeg",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
